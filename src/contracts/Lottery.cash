pragma cashscript ^0.13.0;

contract Lottery(
    pubkey operatorPk,
    bytes20 secretHash,
    int ticketPrice,
    int maxTicketRange,
    int drawDeadline,
    int refundDeadline
) {
    function buyTicket() {
        // Enforce exact ticket fee requirement
        require(tx.inputs[this.activeInputIndex].value >= ticketPrice);

        int currentBalance = tx.inputs[this.activeInputIndex].value;
        int newBalance = currentBalance + ticketPrice;

        require(tx.outputs[0].value == newBalance);
        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2SH32(hash256(this.activeBytecode)));
    }

    function resolveDraw(bytes secret, sig operatorSig, bytes20 winnerPkHash) {
        // Enforce absolute time lock: draw can only happen at or after drawDeadline
        require(tx.time >= drawDeadline);
        
        require(checkSig(operatorSig, operatorPk));
        require(hash160(secret) == secretHash);

        bytes32 entropyHash = sha256(secret + tx.inputs[this.activeInputIndex].outpointTransactionHash);
        int randomSeed = int(entropyHash);
        int winningNumber = (randomSeed % maxTicketRange) + 1;

        require(winningNumber > 0);

        int jackpotAmount = tx.inputs[this.activeInputIndex].value;
        bytes25 winnerLockingBytecode = new LockingBytecodeP2PKH(winnerPkHash);

        require(tx.outputs[0].value == jackpotAmount);
        require(tx.outputs[0].lockingBytecode == winnerLockingBytecode);
    }

    function reclaimRefund(pubkey buyerPk, sig buyerSig) {
        // Enforce absolute time lock for emergency refunds
        require(tx.time >= refundDeadline);
        require(checkSig(buyerSig, buyerPk));
    }
}