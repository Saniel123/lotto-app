pragma cashscript ~0.13.0;

// Transparent 2-Player Lottery Covenant on Bitcoin Cash
contract Lottery(
    pubkey manager,       // Coordinator authorized to trigger the winner payout
    pubkey player1,       // Compressed Public Key of Player 1
    pubkey player2,       // Compressed Public Key of Player 2
    int ticketPrice       // Fixed ticket price in Satoshis (e.g., 100000 = 0.001 BCH)
) {
    // 1. Payout Function: Distributes total jackpot to the winner chosen by manager
    function payout(sig managerSig, pubkey winnerPk) {
        // Enforce that only the manager can sign to initiate the draw
        require(checkSig(managerSig, manager));

        // Enforce that winner MUST be either player1 or player2
        require(winnerPk == player1 || winnerPk == player2);

        // Calculate total jackpot (minus 1000 Satoshis for miner transaction fee)
        int totalPrize = ticketPrice * 2 - 1000;

        // Construct P2PKH locking script for the winner's public key
        bytes20 winnerHash = hash160(winnerPk);
        bytes winnerLockingBytecode = new LockingBytecodeP2PKH(winnerHash);

        // Covenant Enforcement: Force output #0 to send totalPrize directly to winner
        require(tx.outputs[0].value >= totalPrize);
        require(tx.outputs[0].lockingBytecode == winnerLockingBytecode);
    }

    // 2. Refund Function: Enables players to reclaim funds if draw fails past a block target
    function refund(sig playerSig, pubkey playerPk, int expirationHeight) {
        // Time lock safety: Cannot refund before the expiration target block height
        require(tx.time >= expirationHeight);
        
        // Verify signature of the claiming player
        require(checkSig(playerSig, playerPk));
        require(playerPk == player1 || playerPk == player2);

        // Covenant Enforcement: Refund output must return to the claiming player's address
        bytes20 playerHash = hash160(playerPk);
        bytes playerLockingBytecode = new LockingBytecodeP2PKH(playerHash);

        require(tx.outputs[0].lockingBytecode == playerLockingBytecode);
    }
}