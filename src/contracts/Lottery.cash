pragma cashscript ^0.13.0;

contract Lottery(
    int ticketPrice,
    int maxTicketRange
) {

    /**
     * Buy one lottery ticket.
     *
     * Outputs:
     * 0 - Updated lottery contract
     * 1 - OP_RETURN ticket record
     */
    function buyTicket(
        bytes20 buyerPkHash,
        bytes pickedNumbers
    ) {
        // Current jackpot
        int jackpot = tx.inputs[this.activeInputIndex].value;

        // New jackpot after ticket purchase
        int newJackpot = jackpot + ticketPrice;

        // Contract continues with increased balance
        require(
            tx.outputs[0].value == newJackpot
        );

        require(
            tx.outputs[0].lockingBytecode ==
            new LockingBytecodeP2SH32(
                hash256(this.activeBytecode)
            )
        );

        // OP_RETURN ticket record
        bytes ticketRecord =
            0x6a14 + buyerPkHash + pickedNumbers;

        require(tx.outputs[1].value == 0);

        require(
            tx.outputs[1].lockingBytecode ==
            ticketRecord
        );
    }

    /**
     * Resolve the lottery.
     *
     * Anyone may submit a valid BCH block header.
     */
    function resolveDraw(
        bytes header,
        bytes20 winnerPkHash
    ) {

        // BCH block header is 80 bytes
        require(header.length == 80);

        bytes32 blockHash = hash256(header);

        // Basic proof-of-work sanity check
        require(
            blockHash.split(3)[0] == 0x000000
        );

        // Compute winning number
        int winningNumber =
            (int(blockHash) % maxTicketRange) + 1;

        require(winningNumber > 0);

        // Entire jackpot
        int jackpot =
            tx.inputs[this.activeInputIndex].value;

        require(
            tx.outputs[0].value == jackpot
        );

        require(
            tx.outputs[0].lockingBytecode ==
            new LockingBytecodeP2PKH(
                winnerPkHash
            )
        );
    }

    /**
     * Emergency refund.
     */
    function reclaimRefund(
        pubkey buyerPk,
        sig buyerSig
    ) {

        require(
            checkSig(
                buyerSig,
                buyerPk
            )
        );

        require(
            tx.outputs[0].lockingBytecode ==
            new LockingBytecodeP2PKH(
                hash160(buyerPk)
            )
        );

        require(
            tx.outputs[0].value ==
            tx.inputs[this.activeInputIndex].value
        );
    }
}